<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messages"
        android:textSize="30sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hawkeye secure local communication"
        android:textSize="14sp"
        android:alpha="0.65"
        android:paddingBottom="18dp"/>

    <!-- ========================================================= -->
    <!-- ACTIONS -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/newChatButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEW CHAT"/>

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REFRESH"/>
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- CHAT REQUESTS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHAT REQUESTS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:alpha="0.6"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/emptyRequestsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No pending chat requests"
                android:textSize="15sp"
                android:padding="16dp"/>

            <LinearLayout
                android:id="@+id/requestContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- ================================================= -->
            <!-- ACTIVE CONVERSATIONS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTIVE CONVERSATIONS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:alpha="0.6"
                android:paddingTop="28dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/emptyConversationsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No active conversations"
                android:textSize="15sp"
                android:padding="16dp"/>

            <LinearLayout
                android:id="@+id/conversationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>